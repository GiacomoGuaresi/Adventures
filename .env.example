# Copia in .env.local e riempi: .env.local non finisce su git.
# Adventures usa il progetto Supabase di PRODUZIONE di Grocery, anche in sviluppo
# (docs/03, docs/05): `npm run dev` lavora sui dati veri. In CI gli stessi valori
# stanno nelle variabili del repository GitHub.
# URL e chiave sono in Supabase → Project Settings → API Keys. La chiave
# publishable è pubblica per progettazione: i dati li proteggono le policy del
# database, non il segreto della chiave. Mai la chiave secret qui.

VITE_SUPABASE_URL=https://<riferimento-progetto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# L'email dell'account condiviso con Grocery e Projects (Authentication → Users):
# chi entra scrive solo la passphrase, che è la password di questo account.
VITE_SUPABASE_EMAIL=

# La chiave del piano gratuito di openrouteservice (openrouteservice.org →
# Dashboard → API Keys), per il tempo di viaggio automatico. Finisce nel bundle
# pubblico (docs/04-sicurezza.md). Vuota: il tempo si scrive solo a mano.
VITE_OPENROUTESERVICE_KEY=
